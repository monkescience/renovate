{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    ":automergeMinor"
  ],
  "platformAutomerge": true,
  "prHourlyLimit": 0,
  "minimumReleaseAge": "6 days",
  "addLabels": ["renovate"],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["security"]
  },
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "[A-Z0-9_]+:\\s*(?<currentValue>v?[^\\s#]+)\\s*#\\s*renovate:\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<depName>[^\\s]+)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Makefile$/"],
      "matchStrings": [
        "[A-Z0-9_]+\\s*:?=\\s*\"?(?<currentValue>v?[^\\s\"#]+)\"?\\s*#\\s*renovate:\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<depName>[^\\s]+)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)\\.opentofu-version$/"],
      "matchStrings": ["(?<currentValue>.+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "opentofu/opentofu",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["terraform-provider", "terraform-module"],
      "registryUrls": ["https://registry.opentofu.org"]
    },
    {
      "matchDepNames": ["hashicorp/terraform"],
      "enabled": false
    },
    {
      "matchPackageNames": ["ghcr.io/monkescience/yeet"],
      "minimumReleaseAge": null
    }
  ],
  "argocd": {
    "fileMatch": ["apps/.+\\.yaml$"]
  }
}
